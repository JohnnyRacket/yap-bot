# Copy to .env (git ignores it): yap-bot reads it on start. Variables set in the shell win.

# The model: any OpenAI-compatible server
LLM_URL=http://localhost:8080/v1
LLM_MODEL=
# LLM_API_KEY=

# Devices must know this to connect: open the page as https://host:8450/#token=<it> once, or type it
# when asked. Set it before anyone else on the network can reach the agent; it can run your tools.
# YAP_DEVICE_TOKEN=

# Bearer token for POST /api/ask (typed turns from scripts)
# YAP_API_SECRET=

# TZ=America/Chicago
# PORT=8450
# MODELS_DIR=~/.cache/yap-bot/models

# Your tools' own secrets go here too, read as process.env.NAME
