{
  // The published build: JavaScript and declarations in dist/ (Node won't strip types inside node_modules).
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "customConditions": []
  },
  "include": ["src/**/*.ts"]
}
